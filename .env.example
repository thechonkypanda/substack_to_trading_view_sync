# ==============================================================================
# Substack to TradingView Sync Configuration
# ==============================================================================

# Substack Settings
# Your publication subdomain: e.g. 'mytradingnewsletter' for mytradingnewsletter.substack.com
SUBSTACK_SUBDOMAIN=your_publication_subdomain
# Session cookie from your browser when logged in (DevTools -> Application -> Cookies -> substack.com -> substack.sid)
SUBSTACK_SESSION_COOKIE=s%3Ayoursecretsessiontoken...

# Google Sheets Secure Apps Script Web App
# The private Apps Script Web App URL with your secret key (see docs/setup_guide.md for the 7-line script)
GOOGLE_SHEET_WEBAPP_URL=https://script.google.com/macros/s/AKfycb.../exec?key=your_random_secret_passphrase

# TradingView Settings
# Your TradingView sessionid cookie from browser (DevTools -> Cookies -> tradingview.com -> sessionid)
TRADINGVIEW_SESSIONID=your_tradingview_sessionid
# Optional: sessionid_sign cookie (if present in your browser)
TRADINGVIEW_SESSIONID_SIGN=
# The Publication ID of your invite-only Pine Script indicator (e.g. PUB_1234567890abcdef)
TRADINGVIEW_SCRIPT_ID=PUB_your_indicator_id_here
